# ===== SoundVault server =====
# Скопируйте в .env и заполните: cp .env.example .env

# --- qBittorrent (внешний, на хосте; WebUI на 8080) ---
QBT_URL=http://127.0.0.1:8080
QBT_USER=admin
# Задайте постоянный пароль в qbittorrent → Settings → Web UI
QBT_PASS=

# --- Каталог загрузок qBittorrent (абсолютный путь на хосте) ---
# Пробрасывается в контейнер тем же путём; backend берёт пути файлов из qbt API.
DOWNLOADS_DIR=/srv/torrents/downloads

# --- Медиапапки: USB-диски и сетевые монтирования (NAS) ---
# Дополнительные источники музыки (Настройки → Медиапапки). Хост должен быть
# примонтирован (fstab/autofs), контейнеру путь пробрасывается read-only тем же
# именем. Не нужны — можно не задавать (по умолчанию /mnt/music и /mnt/nas-music).
#MEDIA_DIR1=/mnt/music
#MEDIA_DIR2=/mnt/nas-music

# --- Защита веб-интерфейса (HTTP Basic Auth) ---
# Формат user:password. Пусто = доступ без пароля (только для доверенной LAN).
FRONTEND_AUTH=

# --- Аудио-эндпоинты (OAAT) ---
# Пусто = автообнаружение по mDNS (_oaat._tcp) в локальной сети.
# Явный список: Имя=кандидат1|кандидат2,Имя2=... (кандидат: host:port или mdns:ПОДСТРОКА)
OAAT_ENDPOINTS=
# Legacy: один прямой адрес эндпоинта (если не используете mDNS и список выше)
OAAT_TARGET=
# Секретный ключ управления эндпоинтом (не обязателен: авто-ключи приходят через mDNS TXT)
OAAT_CONTROL_TOKEN=

# --- Трекер (витрина раздач RuTracker) ---
RUTRACKER_LOGIN=
RUTRACKER_PASSWORD=
# FlareSolverr нужен для обхода Cloudflare: https://github.com/FlareSolverr/FlareSolverr
FLARESOLVERR_URL=http://127.0.0.1:8191
# Prowlarr (опциональный агрегатор индексаторов)
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=

# --- Публичный доступ через Tailscale (профиль "public") ---
# docker compose --profile public up -d
TS_AUTHKEY=
TS_HOSTNAME=soundvault

# --- OTA-обновление эндпоинтов (GitHub-токен с public_repo, если репо приватный) ---
GITHUB_TOKEN=
