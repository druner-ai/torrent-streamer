# Пароль WebUI qbittorrent (задать постоянный через qbittorrent → Settings → Web UI)
QBT_PASS=adminadmin

# Опциональный ключ для защиты API. Пусто = защита выключена (доступ по LAN без ключа).
API_KEY=

# Prowlarr (индексатор-агрегатор торрентов) для поиска раздач.
# API-ключ можно найти в Prowlarr → Settings → General.
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=
